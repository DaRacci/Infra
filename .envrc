#!/usr/bin/env bash
# shellcheck disable=SC2148

if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

export DEVENV_IN_DIRENV_SHELL=true

watch_file flake.nix
watch_file flake.lock
watch_file terraform/units/proxmox/containers.nix
watch_file terraform/units/proxmox/generate.nix

mkdir -p "$PWD/.devenv"
DEVENV_ROOT_FILE="$PWD/.devenv/root"
printf %s "$PWD" > "$DEVENV_ROOT_FILE"

if ! use flake . \
  --accept-flake-config \
  --allow-import-from-derivation \
  --override-input devenv-root "file+file://$DEVENV_ROOT_FILE"; then
  echo "devenv could not be built. Fix the error above, then run 'direnv reload'." >&2
fi
